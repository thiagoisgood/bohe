/* pages/wiki/wiki.wxss */

.container {
  padding-bottom: 20rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 30rpx;
  background-color: white;
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-input {
  display: flex;
  align-items: center;
  background-color: #F5F5F5;
  border-radius: 50rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.placeholder {
  color: var(--text-hint);
}

.scan-icon {
  width: 36rpx;
  height: 36rpx;
  margin-left: 12rpx;
}

/* 分类导航 */
.category-nav {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 30rpx 20rpx;
  background-color: white;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx;
}

.category-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  margin-bottom: 12rpx;
  background: linear-gradient(135deg, rgba(76, 175, 80, 0.1) 0%, rgba(129, 199, 132, 0.1) 100%);
  border-radius: 50%;
}

.category-name {
  font-size: 22rpx;
  color: var(--text-secondary);
  text-align: center;
}

/* 文章列表 */
.article-list {
  margin-top: 20rpx;
}

/* 推荐文章 */
.featured-article {
  background: linear-gradient(135deg, #E8F5E9 0%, #F1F8E9 100%);
  margin: 0 30rpx 20rpx;
  padding: 40rpx;
  border-radius: 16rpx;
  position: relative;
}

.featured-tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  background-color: var(--primary-color);
  color: white;
  font-size: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.featured-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.featured-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* 文章区块 */
.article-section {
  background-color: white;
  margin-top: 20rpx;
  padding: 30rpx 0;
}

.section-title {
  font-size: 24rpx;
  color: var(--text-hint);
  padding: 0 30rpx 20rpx;
}

/* 文章项 */
.article-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid var(--divider);
}

.article-item:last-child {
  border-bottom: none;
}

.article-info {
  flex: 1;
  margin-right: 20rpx;
}

.article-title {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.5;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.article-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.article-category {
  font-size: 22rpx;
  color: var(--text-hint);
}

.article-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  padding: 6rpx 12rpx;
  background-color: #E8F5E9;
  color: var(--primary-dark);
  font-size: 20rpx;
  border-radius: 6rpx;
}

.article-arrow {
  font-size: 48rpx;
  color: var(--text-hint);
  font-weight: 300;
}
