/* pages/record/record.wxss */

/* 首诊信息横幅 */
.first-visit-banner {
  margin: 30rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #81C784 0%, #4DD0E1 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 16rpx rgba(77, 208, 225, 0.3);
}

.banner-content {
  display: flex;
  align-items: center;
  flex: 1;
}

.banner-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
}

.banner-text {
  flex: 1;
}

.banner-title {
  font-size: 32rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 8rpx;
}

.banner-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.banner-arrow {
  font-size: 48rpx;
  color: white;
  font-weight: 300;
}

/* 卡片头部 */
.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  position: relative;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  flex: 1;
}

.update-time {
  font-size: 22rpx;
  color: var(--text-hint);
  position: absolute;
  left: 0;
  bottom: -30rpx;
}

.add-record-btn,
.record-weight-btn {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
  color: white;
  border-radius: 50rpx;
  font-size: 24rpx;
  border: none;
  line-height: 1;
}

.add-record-btn::after,
.record-weight-btn::after {
  border: none;
}

/* 卡路里统计 */
.calorie-stats {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 40rpx 20rpx 30rpx;
  background: linear-gradient(to bottom, #E8F5E9 0%, #F1F8E9 100%);
  border-radius: 12rpx;
  margin-bottom: 30rpx;
}

.calorie-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.calorie-label {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
  white-space: nowrap;
}

.calorie-value {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.calorie-value.large {
  font-size: 48rpx;
  color: var(--primary-color);
}

.calorie-divider {
  font-size: 28rpx;
  color: var(--text-hint);
  margin: 0 8rpx;
  padding-bottom: 4rpx;
}

/* 快捷入口 */
.meal-shortcuts {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.shortcut-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 10rpx;
}

.shortcut-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.shortcut-name {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 体重记录 */
.current-weight {
  text-align: center;
  margin: 30rpx 0;
}

.weight-value {
  font-size: 80rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.weight-unit {
  font-size: 32rpx;
  color: var(--text-secondary);
  margin-left: 8rpx;
}

/* 体重图表 */
.weight-chart {
  position: relative;
  margin-top: 20rpx;
}

.chart-canvas {
  width: 100%;
  height: 300rpx;
  background: linear-gradient(to bottom, #E8F5E9 0%, rgba(232, 245, 233, 0.1) 100%);
  border-radius: 12rpx;
}

.chart-timeline {
  display: flex;
  justify-content: space-around;
  margin-top: 16rpx;
  padding: 0 30rpx;
}

.timeline-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.timeline-label {
  font-size: 22rpx;
  color: var(--text-hint);
}

/* 健康指标卡片区 */
.health-metrics {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 0 30rpx;
  margin: 20rpx 0;
  box-sizing: border-box;
}

.metric-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.metric-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.metric-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.metric-record-btn {
  padding: 8rpx 20rpx;
  background: white;
  color: var(--primary-color);
  border: 1rpx solid var(--primary-color);
  border-radius: 50rpx;
  font-size: 22rpx;
  max-width: 100rpx;
  line-height: 1;
}

.metric-record-btn::after {
  border: none;
}

.metric-tip {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-bottom: 20rpx;
}

.metric-value-container {
  display: flex;
  align-items: baseline;
  position: relative;
  margin-top: 10rpx;
}

.metric-value {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-right: 8rpx;
}

.metric-unit {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.metric-icon {
  position: absolute;
  right: 0;
  bottom: -10rpx;
  font-size: 56rpx;
  opacity: 0.3;
}

/* 食物搜索弹窗 */
.food-search-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 90vh;
  background: white;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s ease-out;
}

.modal-content.modal-show {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.back-btn {
  font-size: 48rpx;
  color: var(--text-primary);
  width: 60rpx;
  line-height: 1;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  flex: 1;
  text-align: center;
}

.placeholder {
  width: 60rpx;
}

/* 搜索容器 */
.search-container {
  padding: 20rpx 30rpx;
  background: white;
}

.search-box {
  display: flex;
  align-items: center;
  background: #F5F5F5;
  border-radius: 50rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.search-placeholder {
  color: var(--text-hint);
}

/* 食物列表 */
.food-list {
  flex: 1;
  padding: 0 30rpx;
}

.food-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.food-item:last-child {
  border-bottom: none;
}

.food-icon {
  width: 80rpx;
  height: 80rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 20rpx;
}

.food-info {
  flex: 1;
}

.food-name {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  font-weight: 500;
}

.food-detail {
  font-size: 24rpx;
  color: var(--text-secondary);
}

